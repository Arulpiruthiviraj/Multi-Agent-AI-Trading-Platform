<?xml version="1.0" encoding="UTF-8"?>
<!--
  Argus Quant Core (Java 26) — Phase 0 scaffolding.

  ISOLATION CONTRACT (see docs/architecture/JAVA_QUANT_CORE_MIGRATION_BLUEPRINT.md):
  This subproject builds and tests completely independently of the root npm/TypeScript app.
  It has zero broker dependencies, zero network listeners in Phase 0, and is never invoked by
  server.ts, RiskEngine.ts, ChiefTraderAgent, or OrderManagementService. It is inert scaffolding
  only — nothing in the live Node process imports or depends on this module.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.argus</groupId>
  <artifactId>quant-core-java</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Argus Quant Core</name>
  <description>
    Advisory-only, standalone quantitative calculation engine (Phase 0: indicator math + ring
    buffers, byte-parity tested against the live TypeScript implementations). No broker access,
    no order placement, no live wiring. See docs/architecture/JAVA_QUANT_CORE_MIGRATION_BLUEPRINT.md.
  </description>

  <properties>
    <maven.compiler.release>26</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.26.3</assertj.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Phase 4 only dependency: reads real OHLCV bars from data/argus.db (read-only) for the
         backtest engine. A plain JDBC driver, not an app framework - kept to the "no heavy
         frameworks" spirit established in Phase 0. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.47.1.0</version>
    </dependency>
    <!-- Multi-Library Java Quant Decision Intelligence Integration (2026-09-23), Phase 0/1
         research (versions/Java-floors/licenses/deps verified live against Maven Central
         maven-metadata.xml and each project's own pom.xml at its release tag, not assumed):
         - ta4j: independent, separately-authored TA-indicator implementation - used ONLY for
           parity-checking against Argus's own hand-rolled indicator math (the same class of bug
           the 2026-09-22 MACDEngine defect was), never a new capability. Requires Java 25+
           (confirmed real/enforced via that project's own Maven Enforcer rule) - Argus already
           targets Java 26 (maven.compiler.release above), so no conflict.
         - ojAlgo: zero production dependencies (matches this module's own "no heavy frameworks"
           posture almost exactly), real LP/QP/MIP solvers + matrix/linear-algebra layer - a
           genuine capability Argus's hand-rolled MeanVarianceOptimizer/RiskParityOptimizer don't
           have (a real, tested numerical solver instead of custom optimization code). Java 11
           floor, comfortably under Argus's Java 26.
         finmath-lib and OpenGamma Strata were researched in the same pass and deliberately NOT
         added here: finmath-lib pulls in jblas, a native/JNI-backed linear-algebra library with
         real cross-platform loading risk, worth an isolated test before committing (not yet
         done); Strata is a full OTC-derivatives/rates/FX pricing and market-risk platform - its
         domain (swaps, bonds, FX options, curve construction) has essentially zero overlap with
         Argus's actual equity trading capabilities, and Argus's own NOT_SUPPORTED list already
         excludes options and CAD FX. Deferred with reasoning, not silently dropped - see
         docs/architecture/ARGUS_ARCHITECTURE.md's dated entry for this integration pass. -->
    <dependency>
      <groupId>org.ta4j</groupId>
      <artifactId>ta4j-core</artifactId>
      <version>0.25.0</version>
    </dependency>
    <dependency>
      <groupId>org.ojalgo</groupId>
      <artifactId>ojalgo</artifactId>
      <version>57.3.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <!-- No shading needed - zero runtime dependencies (JUnit/AssertJ are test-scoped only),
             so a plain jar with a Main-Class manifest entry is directly runnable. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.argus.quantcore.server.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
