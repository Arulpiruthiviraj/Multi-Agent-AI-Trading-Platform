#!/usr/bin/env bash
# ARGUS shell operator control plane — thin router over npm run argus-cli / npm scripts.
# Does NOT contain RiskEngine, OMS, BrokerManager, or trading logic.
# See ARGUS_SHELL_CLI.md and ARGUS_CLI.md.

set -uo pipefail

ARGUS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ARGUS_ROOT
export ARGUS_API_URL="${ARGUS_API_URL:-http://127.0.0.1:3000}"

# shellcheck source=scripts/cli/common.sh
. "$ARGUS_ROOT/scripts/cli/common.sh"

cmd="${1:-help}"
shift || true

case "$cmd" in
  -h|--help|help)
    argus_help_main
    exit 0
    ;;
  -v|--version|version)
    argus_version
    exit 0
    ;;
  start)
    if argus_wants_help "$@"; then argus_help_start; exit 0; fi
    argus_cmd_start "$@"
    ;;
  stop)
    if argus_wants_help "$@"; then argus_help_stop; exit 0; fi
    argus_npm_cli stop
    ;;
  restart)
    if argus_wants_help "$@"; then argus_help_restart; exit 0; fi
    argus_npm_cli restart
    ;;
  nuke)
    if argus_wants_help "$@"; then
      echo "Usage: argus nuke"
      echo "  Force-kills stale/zombie Argus processes (engine, ecosystem launcher, Chronos, Java Quant Core)."
      echo "  No services are started afterward. Delegates to argus.sh's own nuke action - same behavior"
      echo "  whether invoked as './argus nuke' or './argus.sh nuke'."
      exit 0
    fi
    exec "$ARGUS_ROOT/argus.sh" nuke
    ;;
  status)
    if argus_wants_help "$@"; then argus_help_status; exit 0; fi
    argus_cmd_status "$@"
    ;;
  health)
    if argus_wants_help "$@"; then argus_help_health; exit 0; fi
    argus_cmd_health "$@"
    ;;
  ready)
    if argus_wants_help "$@"; then argus_help_ready; exit 0; fi
    argus_cmd_ready "$@"
    ;;
  pipeline-ready)
    if argus_wants_help "$@"; then
      echo "Usage: argus pipeline-ready"
      echo "  Distinguishes process-alive from trading-pipeline-ready: Process, Database, Market"
      echo "  Data, Broker, Technical Engine, Quant Engine, and AI Provider Layer (per-provider),"
      echo "  each reported independently. Not LIVE readiness (see 'argus ready') - read-only"
      echo "  PAPER/operational diagnostic; never arms LIVE, never toggles Autobot."
      exit 0
    fi
    argus_npm_cli pipeline-ready
    ;;
  session-report|trading-audit)
    if argus_wants_help "$@"; then
      echo "Usage: argus session-report (alias: trading-audit)"
      echo "  Pre-market/market-open operator observability: ideas generated/rejected, missing-price"
      echo "  count, consensus/risk/execution counters, AI provider health, safety flags - scoped to"
      echo "  the current trading day. Organic PAPER/LIVE activity is always reported separately from"
      echo "  REPLAY/BACKTEST/SIMULATION (see the report's own Execution Context Breakdown section)."
      echo "  'trading-audit' is a thin alias for the same report/route - not a second implementation."
      exit 0
    fi
    argus_npm_cli session-report
    ;;
  enable|disable|kill-switch)
    if argus_wants_help "$@"; then argus_help_trading; exit 0; fi
    argus_npm_cli "$cmd" "$@"
    ;;
  research)
    argus_npm_cli "$cmd" "$@"
    ;;
  positions|trades|orders|config|risk|agents)
    if argus_wants_help "$@"; then argus_help_obs; exit 0; fi
    argus_npm_cli "$cmd" "$@"
    ;;
  events|logs)
    if argus_wants_help "$@"; then argus_help_obs; exit 0; fi
    argus_cmd_obs_follow_guard "$cmd" "$@"
    ;;
  replay)
    # Empty / top-level help → replay help. Subcommands (incl. run --help) handled in argus_cmd_replay.
    if [[ "${1:-}" == "" || "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
      argus_help_replay
      exit 0
    fi
    argus_cmd_replay "$@"
    ;;
  login|logout)
    if argus_wants_help "$@"; then argus_help_auth; exit 0; fi
    argus_npm_cli "$cmd" "$@"
    ;;
  doctor)
    if argus_wants_help "$@"; then argus_help_doctor; exit 0; fi
    argus_cmd_doctor "$@"
    ;;
  check)
    if argus_wants_help "$@"; then argus_help_check; exit 0; fi
    argus_cmd_check "$@"
    ;;
  test)
    if argus_wants_help "$@"; then echo "Usage: argus test"; exit 0; fi
    (cd "$ARGUS_ROOT" && npm test)
    ;;
  build)
    if argus_wants_help "$@"; then echo "Usage: argus build"; exit 0; fi
    (cd "$ARGUS_ROOT" && npm run build)
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Run: argus help" >&2
    exit "$ARGUS_EXIT_USAGE"
    ;;
esac
