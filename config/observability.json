{
  "$comment": "Observability retention, sampling, queue bounds, and taxonomy. Not a UI knob. Missing required keys fail boot. Never put secrets here.",
  "schemaVersion": 1,
  "sessionIdPrefix": "sess",
  "levels": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"],
  "persistMinLevel": "INFO",
  "consoleMinLevel": "INFO",
  "batchFlushMs": 75,
  "maxBatchSize": 100,
  "maxQueueSize": 2000,
  "dropPolicy": "newest",
  "retentionDays": 14,
  "retentionSweepMs": 3600000,
  "marketDataSampleEveryN": 50,
  "processTelemetryIntervalMs": 15000,
  "processTelemetryRingSize": 120,
  "marketDataPersist": false,
  "maxPayloadChars": 8000,
  "promptHashLength": 16,
  "legacyJsonlMaxBytes": 10485760,
  "legacyJsonlMaxBackups": 5,
  "safetyCategories": [
    "TRADING_SAFETY",
    "RISK",
    "ORDER",
    "FILL",
    "KILL_SWITCH",
    "RECONCILIATION",
    "LIVE_ARM",
    "BROKER"
  ],
  "safetyMinLevel": "INFO",
  "eventTaxonomy": {
    "MARKET_DATA": { "category": "MARKET_DATA", "defaultLevel": "TRACE", "sampled": true },
    "MARKET_DATA_UPDATED": { "category": "MARKET_DATA", "defaultLevel": "TRACE", "sampled": true },
    "CALCULATION_COMPLETED": { "category": "MARKET_DATA", "defaultLevel": "TRACE", "sampled": true },
    "TRADE_IDEA_GENERATED": { "category": "AGENT", "defaultLevel": "INFO" },
    "CHIEF_APPROVED_IDEA": { "category": "CONSENSUS", "defaultLevel": "INFO" },
    "CHIEF_CONSENSUS_STARTED": { "category": "CONSENSUS", "defaultLevel": "INFO" },
    "CHIEF_CONSENSUS_COMPLETED": { "category": "CONSENSUS", "defaultLevel": "INFO" },
    "AGENT_DISAGREEMENT": { "category": "CONSENSUS", "defaultLevel": "INFO" },
    "RISK_ASSESSMENT_STARTED": { "category": "RISK", "defaultLevel": "INFO" },
    "RISK_ASSESSMENT_COMPLETED": { "category": "RISK", "defaultLevel": "INFO" },
    "RISK_GATE_EVALUATED": { "category": "RISK", "defaultLevel": "INFO" },
    "RISK_BLOCK": { "category": "RISK", "defaultLevel": "WARN" },
    "CAPITAL_BLOCK": { "category": "RISK", "defaultLevel": "WARN" },
    "CAPITAL_CHECK": { "category": "RISK", "defaultLevel": "INFO" },
    "ORDER_SUBMITTED": { "category": "ORDER", "defaultLevel": "INFO" },
    "ORDER_ACCEPTED": { "category": "ORDER", "defaultLevel": "INFO" },
    "ORDER_FILLED": { "category": "FILL", "defaultLevel": "INFO" },
    "ORDER_EXECUTED": { "category": "ORDER", "defaultLevel": "INFO" },
    "KILL_SWITCH_TRIGGERED": { "category": "KILL_SWITCH", "defaultLevel": "ERROR" },
    "TRADING_STATE_CHANGED": { "category": "TRADING_SAFETY", "defaultLevel": "WARN" },
    "RECONCILIATION_MISMATCH": { "category": "RECONCILIATION", "defaultLevel": "WARN" },
    "RECONCILIATION_MATCH": { "category": "RECONCILIATION", "defaultLevel": "INFO" },
    "RECONCILIATION_EMERGENCY_HALT": { "category": "RECONCILIATION", "defaultLevel": "ERROR" },
    "RECONCILIATION_WARMUP": { "category": "RECONCILIATION", "defaultLevel": "INFO" },
    "TRACE_SPAN": { "category": "TRACE", "defaultLevel": "DEBUG" },
    "DATA_STALE": { "category": "MARKET_DATA", "defaultLevel": "WARN" },
    "MARKET_DATA_DISCONNECTED": { "category": "MARKET_DATA", "defaultLevel": "WARN" },
    "MARKET_DATA_GAP_DETECTED": { "category": "MARKET_DATA", "defaultLevel": "WARN" },
    "MARKET_DATA_REJECTED": { "category": "MARKET_DATA", "defaultLevel": "WARN" },
    "TRADE_IDEA_REJECTED": { "category": "AGENT", "defaultLevel": "WARN" },
    "AI_PROVIDERS_EXHAUSTED": { "category": "AI", "defaultLevel": "ERROR" },
    "MODEL_UNAVAILABLE": { "category": "AI", "defaultLevel": "WARN" },
    "MODEL_FALLBACK": { "category": "AI", "defaultLevel": "WARN" },
    "SYSTEM_ANOMALY": { "category": "SYSTEM", "defaultLevel": "ERROR" },
    "DESK_NO_TRADE": { "category": "AGENT", "defaultLevel": "INFO" },
    "TRADE_LIFECYCLE": { "category": "ORDER", "defaultLevel": "INFO" }
  }
}
