{
  "$comment": "Thesis-invalidation rules. Strategy ids and thresholds live here — ThesisInvalidation.ts only interprets rule types. Changing this file is a reviewed config change, not an API knob. Preserve pre-extraction behavior.",
  "biasLabels": {
    "BUY": "long",
    "SELL": "short"
  },
  "rules": [
    {
      "type": "regime_not_in_applicable",
      "message": "Market regime flipped from {entryRegime} to {liveRegime} (no longer in [{applicable}])."
    },
    {
      "type": "rvol_below",
      "threshold": 1.2,
      "strategies": ["MOMENTUM_BREAKOUT", "OPENING_RANGE_BREAKOUT", "VWAP_VOLUME_STRUCTURE", "DONCHIAN_CHANNEL_BREAKOUT", "PREVIOUS_PERIOD_BREAKOUT", "BOLLINGER_VOLATILITY", "GAP_CONTINUATION", "VOLUME_CONFIRMATION"],
      "textIncludes": ["RVOL"],
      "message": "RVOL collapsed to {rvol}x (below {threshold}x follow-through)."
    },
    {
      "type": "false_breakout_through_structural_level",
      "message": "Price closed back through the structural level {level} (false breakout)."
    },
    {
      "type": "adx_below",
      "threshold": 20,
      "strategies": ["TREND_FOLLOWING", "DONCHIAN_CHANNEL_BREAKOUT", "VWAP_VOLUME_STRUCTURE", "MA_CROSSOVER", "RELATIVE_STRENGTH_ROTATION"],
      "textIncludes": ["ADX"],
      "message": "ADX faded to {adx} (below {threshold} - trend strength gone)."
    },
    {
      "type": "choch_against_side",
      "message": "Market structure printed {structureEvent} against the {side} thesis."
    },
    {
      "type": "close_through_structural_level",
      "strategies": ["SMC_LIQUIDITY_SWEEP"],
      "message": "Price closed back through the SMC sweep extreme {level} (continuation against the {bias})."
    },
    {
      "type": "structure_trend_against_side",
      "strategies": ["MEAN_REVERSION", "PULLBACK_CONTINUATION", "VWAP_MEAN_REVERSION", "VWAP_VOLUME_STRUCTURE", "FIBONACCI_PULLBACK", "CANDLESTICK_REVERSAL", "SR_BOUNCE", "OSCILLATOR_MOMENTUM", "STATISTICAL_MEAN_REVERSION"],
      "message": "Market structure trend flipped to {structureTrend}."
    },
    {
      "type": "close_through_structural_level",
      "strategies": ["OPENING_RANGE_BREAKOUT", "DONCHIAN_CHANNEL_BREAKOUT", "PREVIOUS_PERIOD_BREAKOUT", "BOLLINGER_VOLATILITY", "SR_BOUNCE"],
      "message": "Price closed back through the breakout level {level} (false breakout against the {bias})."
    },
    {
      "type": "close_through_structural_level",
      "strategies": ["RANGE_REVERSION"],
      "message": "Close {close} broke the range boundary {level}."
    }
  ]
}
