{
  "name": "my-money-miner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/ecosystem-dev.ts",
    "dev:core": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/devWithOpenAlice.ts",
    "dev:server-only": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "argus": "bash ./argus.sh",
    "stop": "bash ./argus.sh stop",
    "status": "bash ./argus.sh status",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop argus",
    "pm2:logs": "pm2 logs argus",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:scan-writes": "tsx scripts/scan_unallowlisted_writes.ts",
    "research:probe-env": "python scripts/probe_research_env.py",
    "research:ingest-warehouse": "tsx scripts/ingest_research_warehouse.ts",
    "research:canonical": "tsx scripts/run_canonical_research.ts",
    "setup:ai": "python scripts/bootstrap_models.py",
    "ai:serve": "python scripts/local_ai_service.py",
    "db:migrate": "tsx database/migrate.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "alpaca-mcp": "^1.0.2",
    "better-sqlite3": "^12.11.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.7",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "uuid": "^14.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
